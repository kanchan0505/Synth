# ─── Synth Next.js Frontend — Environment Variables ────────────────────────────
#
# Copy this file to .env.local and fill in your values.
# Variables prefixed with NEXT_PUBLIC_ are safe to expose to the browser.
# Never put secret API keys (Groq, Tavily) in this file — those live in
# the FastAPI backend's .env, not here.
#
# ── Required ────────────────────────────────────────────────────────────────────

# URL of your running FastAPI backend.
# Local dev:  http://127.0.0.1:8000
# Production: https://your-app.onrender.com  (or your Railway / Fly.io URL)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# ── Optional ─────────────────────────────────────────────────────────────────────
# (Add here if you add auth, analytics, etc. in the future)
